<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="#121212"> <!-- Ciemne tło pasujące do trybu nocnego -->

    <!-- Duży, czerwony przycisk SOS -->
    <Button
        android:id="@+id/id_przycisku_sos"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:text="SOS"
        android:textSize="56sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@android:color/holo_red_dark"
        android:layout_marginBottom="32dp" />

    <!-- Główna instrukcja -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRZYTRZYMAJ 3 SEKUNDY DO POMOCY"
        android:textAlignment="center"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#BBBBBB" />

    <!-- Dodatkowy opis działania -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Aktywacja natychmiast zadzwoni pod 112\ni wyśle SMS-a z lokalizacją na numery zapisane w profilu."
        android:textAlignment="center"
        android:textSize="14sp"
        android:textColor="#777777" />

</LinearLayout>