<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:clipToPadding="false"
    android:padding="16dp"
    android:paddingTop="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_rounded_panel"
            android:backgroundTint="#1E1E1E"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_trust_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FF028D"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trust Score"
                    android:textColor="#888888"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tv_trust_breakdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="0 zgłoszeń | 0 polubień | 0 oznaczeń"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="+5 zgłoszenie | +2 👍"
                    android:textColor="#777777"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="48dp"
                android:background="#333333"
                android:layout_marginHorizontal="8dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status konta"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_phone_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Niezweryfikowany"
                    android:textColor="#FFC107"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_rounded_panel"
            android:backgroundTint="#1A1A1A"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="DANE PROFILU"
                android:textColor="#FF028D"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Nazwa użytkownika"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_nickname"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#444444"
                android:hint="Nick (np. @Ania)"
                android:paddingHorizontal="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Numer telefonu (tylko do odczytu)"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_phone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#333333"
                android:enabled="false"
                android:focusable="false"
                android:paddingHorizontal="12dp"
                android:textColor="#777777"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_verify_phone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#2A2A2A"
                android:text="Zweryfikuj numer"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:stateListAnimator="@null"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="KONTAKTY SOS (Max 5)"
                android:textColor="#FF028D"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <LinearLayout android:id="@+id/row_sos_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp" android:visibility="gone" android:gravity="center_vertical">
                <EditText android:id="@+id/et_sos_contact_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:hint="Numer SOS (+48...)" android:inputType="phone" android:textColor="#FFFFFF" android:textColorHint="#555555" android:backgroundTint="#444444" android:paddingHorizontal="12dp" android:textSize="14sp"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_del_sos_1" android:layout_width="40dp" android:layout_height="40dp" android:text="✕" android:textColor="#FFFFFF" android:backgroundTint="#B71C1C" android:layout_marginStart="8dp" android:background="@drawable/bg_circle" />
            </LinearLayout>

            <LinearLayout android:id="@+id/row_sos_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp" android:visibility="gone" android:gravity="center_vertical">
                <EditText android:id="@+id/et_sos_contact_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:hint="Numer SOS (+48...)" android:inputType="phone" android:textColor="#FFFFFF" android:textColorHint="#555555" android:backgroundTint="#444444" android:paddingHorizontal="12dp" android:textSize="14sp"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_del_sos_2" android:layout_width="40dp" android:layout_height="40dp" android:text="✕" android:textColor="#FFFFFF" android:backgroundTint="#B71C1C" android:layout_marginStart="8dp" android:background="@drawable/bg_circle" />
            </LinearLayout>

            <LinearLayout android:id="@+id/row_sos_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp" android:visibility="gone" android:gravity="center_vertical">
                <EditText android:id="@+id/et_sos_contact_3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:hint="Numer SOS (+48...)" android:inputType="phone" android:textColor="#FFFFFF" android:textColorHint="#555555" android:backgroundTint="#444444" android:paddingHorizontal="12dp" android:textSize="14sp"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_del_sos_3" android:layout_width="40dp" android:layout_height="40dp" android:text="✕" android:textColor="#FFFFFF" android:backgroundTint="#B71C1C" android:layout_marginStart="8dp" android:background="@drawable/bg_circle" />
            </LinearLayout>

            <LinearLayout android:id="@+id/row_sos_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp" android:visibility="gone" android:gravity="center_vertical">
                <EditText android:id="@+id/et_sos_contact_4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:hint="Numer SOS (+48...)" android:inputType="phone" android:textColor="#FFFFFF" android:textColorHint="#555555" android:backgroundTint="#444444" android:paddingHorizontal="12dp" android:textSize="14sp"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_del_sos_4" android:layout_width="40dp" android:layout_height="40dp" android:text="✕" android:textColor="#FFFFFF" android:backgroundTint="#B71C1C" android:layout_marginStart="8dp" android:background="@drawable/bg_circle" />
            </LinearLayout>

            <LinearLayout android:id="@+id/row_sos_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp" android:visibility="gone" android:gravity="center_vertical">
                <EditText android:id="@+id/et_sos_contact_5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:hint="Numer SOS (+48...)" android:inputType="phone" android:textColor="#FFFFFF" android:textColorHint="#555555" android:backgroundTint="#444444" android:paddingHorizontal="12dp" android:textSize="14sp"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_del_sos_5" android:layout_width="40dp" android:layout_height="40dp" android:text="✕" android:textColor="#FFFFFF" android:backgroundTint="#B71C1C" android:layout_marginStart="8dp" android:background="@drawable/bg_circle" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_add_sos"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#252525"
                android:text="+ Dodaj kolejny numer"
                android:textColor="#FF028D"
                android:textSize="14sp"
                android:stateListAnimator="@null"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Treść wiadomości ratunkowej SMS"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_sos_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#444444"
                android:hint="Wpisz treść (max 100 znaków)"
                android:maxLength="100"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_save_profile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#5A1D5E"
                android:text="Zapisz cały profil i ustawienia"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="MOJE ZGŁOSZENIA"
            android:textColor="#FF028D"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_rounded_panel"
            android:backgroundTint="#1E1E1E"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zagrożenie: Brak oświetlenia"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="📍 ul. Floriańska (Wczoraj, 21:30)"
                android:textColor="#888888"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Potwierdzone przez 5 osób"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_rounded_panel"
            android:backgroundTint="#1E1E1E"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:iconifiedByDefault="false"
                android:layout_height="wrap_content"
                android:text="Zagrożenie: Podejrzana grupa"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="📍 Park Krakowski (Dzisiaj, 18:15)"
                android:textColor="#888888"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Oczekuje na weryfikację"
                android:textColor="#FFC107"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>