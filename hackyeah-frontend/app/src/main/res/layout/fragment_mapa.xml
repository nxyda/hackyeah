<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2C2C2C">

    <!-- MAPA -->
    <com.mapbox.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:mapbox_locationComponentEnabled="true"
        app:mapbox_compassEnabled="true" />

    <!-- WYSZUKIWANIE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:background="@drawable/search_background"
        android:backgroundTint="#3A3A3A"
        android:elevation="8dp">

        <ImageButton
            android:id="@+id/btn_saved_places"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_places"
            app:tint="#FF028D"
            android:contentDescription="Zapisane miejsca" />

        <EditText
            android:id="@+id/search_destination"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Dokąd chcesz iść?"
            android:textColor="#FFFFFF"
            android:textColorHint="#999999"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textSize="16sp" />

        <Button
            android:id="@+id/search_button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="#FF028D"
            android:textColor="#FFFFFF"
            android:text="Szukaj"
            android:textAllCaps="false"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- KOMUNIKATY NAWIGACYJNE -->
    <LinearLayout
        android:id="@+id/navigation_steps_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:background="@drawable/navigation_steps_background"
        android:backgroundTint="#3A3A3A"
        android:elevation="8dp"
        android:visibility="gone">

        <!-- AKTUALNY KROK -->
        <LinearLayout
            android:id="@+id/navigation_current_step"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/navigation_current_icon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="→"
                android:textColor="#FF028D"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/navigation_current_instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Skręć w prawo"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/navigation_current_distance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="za 180 m"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/navigation_expand_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="⌄"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

        </LinearLayout>

        <!-- PEŁNA LISTA -->
        <LinearLayout
            android:id="@+id/navigation_all_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- PODSUMOWANIE TRASY I PRZYCISK WYJŚCIA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/navigation_route_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🛡 Bezpieczna  •  2,4 km  •  9 min"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_exit_navigation"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="✕"
                android:textColor="#F44336"
                android:backgroundTint="@android:color/transparent"
                android:textSize="20sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- PRZYCISK OTWIERANIA WARSTW -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/layers_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="140dp"
        android:text="🗂️"
        android:textSize="20sp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:textAllCaps="false"
        android:elevation="8dp"
        app:cornerRadius="26dp"
        app:backgroundTint="#3A3A3A"
        android:contentDescription="Warstwy mapy" />

    <!-- PANEL WARSTW WYSUWANY OD DOŁU -->
    <LinearLayout
        android:id="@+id/layers_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        android:background="@drawable/bottom_panel_background"
        android:backgroundTint="#323232"
        android:elevation="20dp"
        android:visibility="gone">

        <!-- UCHWYT -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp"
            android:background="#555555" />

        <!-- NAGŁÓWEK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🗂️ Warstwy mapy"
                android:textColor="#FF028D"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/layer_close"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#444444"
                android:textColor="#FFFFFF"
                android:text="Zamknij"
                android:textAllCaps="false" />

        </LinearLayout>

        <!-- ========================= -->
        <!-- RZĄD 1 (3 elementy: x x x) -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <!-- ŚWIATŁO -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_margin="3dp">

                <Button
                    android:id="@+id/layer_lighting"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:backgroundTint="#3A3A3A"
                    android:text="💡"
                    android:textSize="26sp"
                    android:textAllCaps="false"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Światło"
                    android:textColor="#CCCCCC"
                    android:textSize="11sp"
                    android:textAlignment="center"
                    android:gravity="center" />

            </LinearLayout>

            <!-- BEZPIECZNE PUNKTY -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_margin="3dp">

                <Button
                    android:id="@+id/layer_safe_points"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:backgroundTint="#3A3A3A"
                    android:text="🛡"
                    android:textSize="26sp"
                    android:textAllCaps="false"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Bezpieczne punkty"
                    android:textColor="#CCCCCC"
                    android:textSize="11sp"
                    android:textAlignment="center"
                    android:gravity="center" />

            </LinearLayout>

            <!-- KAMERY -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_margin="3dp">

                <Button
                    android:id="@+id/layer_cameras"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:backgroundTint="#3A3A3A"
                    android:text="📷"
                    android:textSize="26sp"
                    android:textAllCaps="false"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Kamery"
                    android:textColor="#CCCCCC"
                    android:textSize="11sp"
                    android:textAlignment="center"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>

        <!-- ========================= -->
        <!-- RZĄD 2 (3 elementy: x x x) -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <!-- HISTORYCZNE ZAGROŻENIA -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_margin="3dp">

                <Button
                    android:id="@+id/layer_historical"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:backgroundTint="#3A3A3A"
                    android:text="🕰"
                    android:textSize="26sp"
                    android:textAllCaps="false"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Historyczne zagrożenia"
                    android:textColor="#CCCCCC"
                    android:textSize="11sp"
                    android:textAlignment="center"
                    android:gravity="center" />

            </LinearLayout>

            <!-- ZGŁOSZENIA UŻYTKOWNIKÓW -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_margin="3dp">

                <Button
                    android:id="@+id/layer_user_reports"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:backgroundTint="#3A3A3A"
                    android:text="🚨"
                    android:textSize="26sp"
                    android:textAllCaps="false"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Zgłoszenia użytkowników"
                    android:textColor="#CCCCCC"
                    android:textSize="11sp"
                    android:textAlignment="center"
                    android:gravity="center" />

            </LinearLayout>

            <!-- WYDARZENIA W MIEŚCIE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_margin="3dp">

                <Button
                    android:id="@+id/layer_city_events"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:backgroundTint="#4E1C51"
                    android:text="🏟"
                    android:textSize="26sp"
                    android:textAllCaps="false"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Wydarzenia w mieście"
                    android:textColor="#CCCCCC"
                    android:textSize="11sp"
                    android:textAlignment="center"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- PRZYCISK DODAWANIA ZGŁOSZENIA -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_report_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="70dp"
        android:text="⚠"
        android:textSize="22sp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:textAllCaps="false"
        android:elevation="8dp"
        app:cornerRadius="28dp"
        app:backgroundTint="#F44336" />

    <!-- INFORMACJE O BEZPIECZNYM PUNKCIE -->
    <LinearLayout
        android:id="@+id/safe_point_info_panel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/report_info_background"
        android:backgroundTint="#323232"
        android:elevation="12dp"
        android:visibility="gone">

        <!-- TYTUŁ -->
        <TextView
            android:id="@+id/safe_point_info_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛡 Bezpieczny punkt"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- NAZWA -->
        <TextView
            android:id="@+id/safe_point_info_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Nazwa:"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- KATEGORIA -->
        <TextView
            android:id="@+id/safe_point_info_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Kategoria:"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <!-- GODZINY -->
        <TextView
            android:id="@+id/safe_point_info_hours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Godziny:"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <!-- 24/7 -->
        <TextView
            android:id="@+id/safe_point_info_247"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="🕐 Czynne 24/7"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- ZAMKNIJ -->
        <Button
            android:id="@+id/safe_point_info_close"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:backgroundTint="#444444"
            android:textColor="#FFFFFF"
            android:text="Zamknij"
            android:textAllCaps="false" />

    </LinearLayout>

    <!-- INFORMACJE O WYDARZENIU W MIEŚCIE -->
    <LinearLayout
        android:id="@+id/city_event_info_panel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/report_info_background"
        android:backgroundTint="#323232"
        android:elevation="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/city_event_info_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏟️ Wydarzenie w mieście"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/city_event_info_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Kategoria:"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/city_event_info_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Opis:"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/city_event_info_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📅 Data:"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/city_event_info_risk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="⚠️ Wpływ na bezpieczeństwo: +25%"
            android:textColor="#FF9800"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/city_event_info_close"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:backgroundTint="#444444"
            android:textColor="#FFFFFF"
            android:text="Zamknij"
            android:textAllCaps="false" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/historical_threat_info_panel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/report_info_background"
        android:backgroundTint="#323232"
        android:elevation="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/historical_threat_info_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ Historyczne zagrożenie"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/historical_threat_info_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Kategoria:"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/historical_threat_info_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Data:"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/historical_threat_info_severity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="🔴 Poziom zagrożenia:"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/historical_threat_info_score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Severity: 0.85"
            android:textColor="#CCCCCC"
            android:textSize="13sp" />

        <Button
            android:id="@+id/historical_threat_info_close"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:backgroundTint="#444444"
            android:textColor="#FFFFFF"
            android:text="Zamknij"
            android:textAllCaps="false" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/report_info_panel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/report_info_background"
        android:backgroundTint="#323232"
        android:elevation="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/report_info_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ Zgłoszone zagrożenie"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/report_info_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Kategoria:"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/report_info_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Godzina:"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/report_info_confirmations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="👥 Potwierdzone przez 4 osoby"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/report_info_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Czy nadal występuje tutaj zagrożenie?"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/report_info_confirm"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:text="👍"
                android:textAllCaps="false"
                android:textSize="13sp" />

            <Button
                android:id="@+id/report_info_invalid"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:text="👎"
                android:textAllCaps="false"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/report_info_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ID:"
            android:textColor="#888888"
            android:textSize="10sp" />

        <Button
            android:id="@+id/report_info_close"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:backgroundTint="#444444"
            android:textColor="#FFFFFF"
            android:text="Zamknij"
            android:textAllCaps="false" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/location_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:background="@drawable/map_button_background"
        android:backgroundTint="#3A3A3A"
        android:contentDescription="Moja lokalizacja"
        android:elevation="8dp"
        android:padding="14dp"
        app:tint="#FFFFFF"
        android:src="@android:drawable/ic_menu_mylocation" />

    <!-- INFORMACJE O TRASIE -->
    <LinearLayout
        android:id="@+id/route_info_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:background="@drawable/bottom_panel_background"
        android:backgroundTint="#323232"
        android:elevation="12dp">

        <TextView
            android:id="@+id/route_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Planowanie trasy"
            android:textColor="#FF028D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/start_point"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="📍 Start: moja lokalizacja"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/destination_point"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="🏁 Cel: nie wybrano"
            android:textColor="#CCCCCC"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/route_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Wybierz miejsce docelowe, aby wyznaczyć trasę."
            android:textColor="#888888"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/safety_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🛡 Poziom bezpieczeństwa: —"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/start_navigation_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Rozpocznij nawigację"
            android:textAllCaps="false"
            android:visibility="gone" />

    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/route_options_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="96dp"
        android:layout_marginEnd="16dp"
        android:elevation="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/safe_route_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:text="🛡 Najlepsza"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/fast_route_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:text="⚡ Najszybsza"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/balanced_route_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="⚖ Alternatywna"
                android:textAllCaps="false" />

        </LinearLayout>
    </HorizontalScrollView>

</FrameLayout>